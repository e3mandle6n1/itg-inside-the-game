# Absolute path to lean match JSON (index.json + *.json). Seeded into Azurite on API start.
MATCH_SEED_DIR=

# Optional — Microsoft Foundry / Azure OpenAI for studio narratives.
# Leave unset to use the rules narrator (tools still compute every number).
# FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# FOUNDRY_MODEL=gpt-4.1-mini
# FOUNDRY_API_KEY=   # empty → DefaultAzureCredential (keyless)
